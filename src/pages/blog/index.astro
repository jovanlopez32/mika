---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const blogPosts = await getCollection('blog');
const sortedPosts = blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return new Date(date).toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<Layout title="Blog - Mikas Food">
  <main>
    <!-- Navegación -->
    <nav class="nav">
      <div class="container">
        <a href="/" class="logo">Mikas</a>
        <div class="nav-menu">
          <a href="/">Inicio</a>
          <a href="/blog">Blog</a>
          <a href="/#contacto">Contacto</a>
        </div>
      </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <h1 class="page-title">Blog</h1>
        <p class="page-subtitle">
          Consejos y guías sobre nutrición para tus mascotas
        </p>
      </div>
    </section>

    <!-- Posts -->
    <section class="posts-section">
      <div class="container">
        <div class="posts-grid">
          {sortedPosts.map((post) => (
            <article class="post-card">
              <a href={`/blog/${post.slug}`}>
                <time class="post-date">{formatDate(post.data.pubDate)}</time>
                <h2 class="post-title">{post.data.title}</h2>
                <p class="post-description">{post.data.description}</p>
                <span class="read-more">Leer artículo →</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <span>© 2024 Mikas Food</span>
          <div class="footer-links">
            <a href="#">Instagram</a>
            <a href="#">Facebook</a>
          </div>
        </div>
      </div>
    </footer>
  </main>

  <style>
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--spacing-md);
    }

    /* Navegación */
    .nav {
      padding: var(--spacing-lg) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .nav .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .nav-menu {
      display: flex;
      gap: var(--spacing-lg);
    }

    .nav-menu a {
      font-size: 16px;
      font-weight: 500;
      color: var(--color-text-light);
      transition: color 0.2s ease;
    }

    .nav-menu a:hover {
      color: var(--color-text);
    }

    /* Hero */
    .hero {
      padding: var(--spacing-2xl) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .page-title {
      font-size: clamp(3rem, 6vw, 5rem);
      font-weight: 800;
      margin-bottom: var(--spacing-sm);
    }

    .page-subtitle {
      font-size: clamp(1.125rem, 2vw, 1.5rem);
      color: var(--color-text-light);
    }

    /* Posts */
    .posts-section {
      padding: var(--spacing-2xl) 0 var(--spacing-3xl);
    }

    .posts-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--spacing-2xl);
    }

    .post-card {
      padding: var(--spacing-xl) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .post-card:last-child {
      border-bottom: none;
    }

    .post-card a {
      display: block;
      transition: opacity 0.2s ease;
    }

    .post-card a:hover {
      opacity: 0.7;
    }

    .post-date {
      display: block;
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-light);
      margin-bottom: var(--spacing-sm);
    }

    .post-title {
      font-size: clamp(1.75rem, 3vw, 2.5rem);
      font-weight: 700;
      margin-bottom: var(--spacing-sm);
      line-height: 1.2;
    }

    .post-description {
      font-size: 1.125rem;
      color: var(--color-text-light);
      line-height: 1.6;
      margin-bottom: var(--spacing-md);
    }

    .read-more {
      font-size: 16px;
      font-weight: 600;
      color: var(--color-text);
    }

    /* Footer */
    .footer {
      padding: var(--spacing-xl) 0;
      border-top: 1px solid var(--color-border);
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      color: var(--color-text-light);
    }

    .footer-links {
      display: flex;
      gap: var(--spacing-md);
    }

    .footer-links a {
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: var(--color-text);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .nav {
        padding: var(--spacing-md) 0;
      }

      .nav-menu {
        gap: var(--spacing-md);
      }

      .hero {
        padding: var(--spacing-xl) 0;
      }

      .posts-section {
        padding: var(--spacing-xl) 0;
      }

      .footer-content {
        flex-direction: column;
        gap: var(--spacing-md);
        text-align: center;
      }
    }
  </style>
</Layout>
