---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const blogPosts = await getCollection('blog');

// Ordenar por fecha más reciente
const sortedPosts = blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return new Date(date).toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<Layout title="Blog - Mikas Food">
  <main>
    <!-- Navegación -->
    <nav class="nav">
      <div class="nav-container">
        <a href="/" class="logo">
          <img src="/images/mika-logo.png" alt="Mikas Food" />
        </a>
        <div class="nav-links">
          <a href="/">Inicio</a>
          <a href="/blog" class="active">Blog</a>
          <a href="/#contacto" class="btn-contact">Contáctanos</a>
        </div>
      </div>
    </nav>

    <!-- Hero del Blog -->
    <section class="blog-hero">
      <div class="container">
        <h1>Blog de Mikas Food</h1>
        <p>Consejos, guías y todo lo que necesitas saber sobre la nutrición de tus mascotas</p>
      </div>
    </section>

    <!-- Listado de Artículos -->
    <section class="blog-list">
      <div class="container">
        <div class="posts-grid">
          {sortedPosts.map((post) => (
            <article class="post-card">
              <div class="post-content">
                <div class="post-meta">
                  <span class="post-date">{formatDate(post.data.pubDate)}</span>
                  <span class="post-author">Por {post.data.author}</span>
                </div>
                <h2>
                  <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                </h2>
                <p class="post-description">{post.data.description}</p>
                <div class="post-tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                <a href={`/blog/${post.slug}`} class="read-more">
                  Leer artículo →
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-logo">
            <img src="/images/mika-logo.png" alt="Mikas Food" />
            <p>Nutrición natural para mascotas felices</p>
          </div>

          <div class="footer-social">
            <a href="#" aria-label="Facebook">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="#" aria-label="Instagram">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; 2024 Mikas Food. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>
  </main>

  <style>
    /* Navegación */
    .nav {
      padding: 1.5rem 0;
      background: var(--color-background);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo img {
      height: 60px;
      width: auto;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      align-items: center;
    }

    .nav-links a {
      font-weight: 500;
      transition: color 0.3s ease;
      color: var(--color-text);
    }

    .nav-links a.active {
      color: var(--color-secondary);
    }

    .nav-links a:not(.btn-contact):hover {
      color: var(--color-secondary);
    }

    .btn-contact {
      padding: 0.75rem 2rem;
      background: var(--color-primary);
      color: white !important;
      font-weight: 500;
      transition: background 0.3s ease;
    }

    .btn-contact:hover {
      background: var(--color-accent);
    }

    /* Hero del Blog */
    .blog-hero {
      padding: 4rem 0;
      background: var(--color-background-alt);
      text-align: center;
    }

    .blog-hero h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
      color: var(--color-primary);
    }

    .blog-hero p {
      font-size: 1.25rem;
      color: var(--color-text-light);
      max-width: 600px;
      margin: 0 auto;
    }

    /* Listado de Posts */
    .blog-list {
      padding: 4rem 0;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .posts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 2.5rem;
    }

    .post-card {
      background: var(--color-background);
      transition: transform 0.3s ease;
      padding: 2rem;
      border-top: 4px solid var(--color-secondary);
    }

    .post-card:hover {
      transform: translateY(-5px);
    }

    .post-meta {
      display: flex;
      gap: 1rem;
      margin-bottom: 1rem;
      font-size: 0.875rem;
      color: var(--color-text-light);
    }

    .post-card h2 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      line-height: 1.3;
    }

    .post-card h2 a {
      color: var(--color-primary);
      transition: color 0.3s ease;
    }

    .post-card h2 a:hover {
      color: var(--color-secondary);
    }

    .post-description {
      color: var(--color-text-light);
      margin-bottom: 1.5rem;
      line-height: 1.6;
    }

    .post-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .tag {
      background: var(--color-background-alt);
      padding: 0.25rem 0.75rem;
      font-size: 0.875rem;
      color: var(--color-accent);
    }

    .read-more {
      color: var(--color-secondary);
      font-weight: 600;
      transition: opacity 0.3s ease;
    }

    .read-more:hover {
      opacity: 0.8;
    }

    /* Footer */
    .footer {
      padding: 3rem 0 1.5rem;
      background: var(--color-background-alt);
      margin-top: 4rem;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .footer-logo img {
      height: 50px;
      margin-bottom: 0.75rem;
    }

    .footer-logo p {
      color: var(--color-text-light);
    }

    .footer-social {
      display: flex;
      gap: 1.5rem;
    }

    .footer-social a {
      color: var(--color-accent);
      transition: color 0.3s ease;
    }

    .footer-social a:hover {
      color: var(--color-secondary);
    }

    .footer-bottom {
      text-align: center;
      padding-top: 2rem;
      border-top: 1px solid #E5E7EB;
    }

    .footer-bottom p {
      color: var(--color-text-light);
      font-size: 0.875rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .nav-links {
        gap: 1rem;
        font-size: 0.875rem;
      }

      .blog-hero h1 {
        font-size: 2rem;
      }

      .posts-grid {
        grid-template-columns: 1fr;
      }

      .footer-content {
        flex-direction: column;
        gap: 2rem;
        text-align: center;
      }
    }
  </style>
</Layout>
