---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date) {
  return new Date(date).toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// Obtener posts relacionados (por tags)
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug && p.data.tags.some(tag => post.data.tags.includes(tag)))
  .slice(0, 3);
---

<Layout title={`${post.data.title} - Mikas Food Blog`}>
  <main>
    <!-- Navegación -->
    <nav class="nav">
      <div class="nav-container">
        <a href="/" class="logo">
          <img src="/images/mika-logo.png" alt="Mikas Food" />
        </a>
        <div class="nav-links">
          <a href="/">Inicio</a>
          <a href="/blog" class="active">Blog</a>
          <a href="/#contacto" class="btn-contact">Contáctanos</a>
        </div>
      </div>
    </nav>

    <!-- Artículo -->
    <article class="article">
      <div class="article-container">
        <!-- Header del artículo -->
        <header class="article-header">
          <div class="breadcrumb">
            <a href="/">Inicio</a>
            <span>/</span>
            <a href="/blog">Blog</a>
            <span>/</span>
            <span>{post.data.title}</span>
          </div>

          <h1>{post.data.title}</h1>
          <p class="article-description">{post.data.description}</p>

          <div class="article-meta">
            <span class="meta-item">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
              </svg>
              {formatDate(post.data.pubDate)}
            </span>
            <span class="meta-item">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
              </svg>
              {post.data.author}
            </span>
          </div>

          <div class="article-tags">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </header>

        <!-- Contenido del artículo -->
        <div class="article-content">
          <Content />
        </div>

        <!-- CTA al final del artículo -->
        <div class="article-cta">
          <h3>¿Te gustó este artículo?</h3>
          <p>Descubre cómo Mikas Food puede transformar la alimentación de tu mascota</p>
          <a href="/#contacto" class="btn-primary">Contáctanos</a>
        </div>
      </div>
    </article>

    <!-- Posts Relacionados -->
    {relatedPosts.length > 0 && (
      <section class="related-posts">
        <div class="container">
          <h2>Artículos Relacionados</h2>
          <div class="posts-grid">
            {relatedPosts.map((relatedPost) => (
              <article class="post-card">
                <div class="post-content">
                  <div class="post-meta">
                    <span class="post-date">{formatDate(relatedPost.data.pubDate)}</span>
                  </div>
                  <h3>
                    <a href={`/blog/${relatedPost.slug}`}>{relatedPost.data.title}</a>
                  </h3>
                  <p class="post-description">{relatedPost.data.description}</p>
                  <a href={`/blog/${relatedPost.slug}`} class="read-more">
                    Leer artículo →
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-logo">
            <img src="/images/mika-logo.png" alt="Mikas Food" />
            <p>Nutrición natural para mascotas felices</p>
          </div>

          <div class="footer-social">
            <a href="#" aria-label="Facebook">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="#" aria-label="Instagram">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; 2024 Mikas Food. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>
  </main>

  <style>
    /* Navegación */
    .nav {
      padding: 1.5rem 0;
      background: var(--color-background);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo img {
      height: 60px;
      width: auto;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      align-items: center;
    }

    .nav-links a {
      font-weight: 500;
      transition: color 0.3s ease;
      color: var(--color-text);
    }

    .nav-links a.active {
      color: var(--color-secondary);
    }

    .nav-links a:not(.btn-contact):hover {
      color: var(--color-secondary);
    }

    .btn-contact {
      padding: 0.75rem 2rem;
      background: var(--color-primary);
      color: white !important;
      font-weight: 500;
      transition: background 0.3s ease;
    }

    .btn-contact:hover {
      background: var(--color-accent);
    }

    /* Artículo */
    .article {
      padding: 3rem 0;
    }

    .article-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .breadcrumb {
      display: flex;
      gap: 0.5rem;
      font-size: 0.875rem;
      color: var(--color-text-light);
      margin-bottom: 2rem;
    }

    .breadcrumb a {
      color: var(--color-secondary);
      transition: opacity 0.3s ease;
    }

    .breadcrumb a:hover {
      opacity: 0.8;
    }

    .article-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 2px solid var(--color-background-alt);
    }

    .article-header h1 {
      font-size: 2.5rem;
      line-height: 1.2;
      margin-bottom: 1rem;
      color: var(--color-primary);
    }

    .article-description {
      font-size: 1.25rem;
      color: var(--color-text-light);
      margin-bottom: 1.5rem;
      line-height: 1.6;
    }

    .article-meta {
      display: flex;
      gap: 2rem;
      margin-bottom: 1rem;
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--color-text-light);
      font-size: 0.875rem;
    }

    .meta-item svg {
      color: var(--color-secondary);
    }

    .article-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tag {
      background: var(--color-background-alt);
      padding: 0.35rem 0.85rem;
      font-size: 0.875rem;
      color: var(--color-accent);
      font-weight: 500;
    }

    /* Contenido del artículo */
    .article-content {
      font-size: 1.125rem;
      line-height: 1.8;
      color: var(--color-text);
    }

    .article-content :global(h2) {
      font-size: 2rem;
      margin-top: 3rem;
      margin-bottom: 1rem;
      color: var(--color-primary);
    }

    .article-content :global(h3) {
      font-size: 1.5rem;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
      color: var(--color-primary);
    }

    .article-content :global(h4) {
      font-size: 1.25rem;
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
      color: var(--color-primary);
    }

    .article-content :global(p) {
      margin-bottom: 1.5rem;
    }

    .article-content :global(ul),
    .article-content :global(ol) {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
    }

    .article-content :global(li) {
      margin-bottom: 0.5rem;
    }

    .article-content :global(strong) {
      color: var(--color-primary);
      font-weight: 600;
    }

    .article-content :global(a) {
      color: var(--color-secondary);
      font-weight: 500;
      transition: opacity 0.3s ease;
    }

    .article-content :global(a:hover) {
      opacity: 0.8;
    }

    .article-content :global(blockquote) {
      border-left: 4px solid var(--color-secondary);
      padding-left: 1.5rem;
      margin: 2rem 0;
      font-style: italic;
      color: var(--color-text-light);
    }

    .article-content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 2rem 0;
    }

    .article-content :global(th),
    .article-content :global(td) {
      padding: 0.75rem;
      text-align: left;
      border-bottom: 1px solid var(--color-background-alt);
    }

    .article-content :global(th) {
      background: var(--color-background-alt);
      font-weight: 600;
      color: var(--color-primary);
    }

    /* CTA del artículo */
    .article-cta {
      background: var(--color-background-alt);
      padding: 3rem;
      text-align: center;
      margin: 4rem 0;
    }

    .article-cta h3 {
      font-size: 1.75rem;
      margin-bottom: 1rem;
      color: var(--color-primary);
    }

    .article-cta p {
      font-size: 1.125rem;
      color: var(--color-text-light);
      margin-bottom: 2rem;
    }

    .btn-primary {
      display: inline-block;
      padding: 1rem 2.5rem;
      background: var(--color-secondary);
      color: white;
      font-weight: 600;
      font-size: 1.125rem;
      transition: transform 0.3s ease, background 0.3s ease;
    }

    .btn-primary:hover {
      background: #d66e43;
      transform: translateY(-2px);
    }

    /* Posts relacionados */
    .related-posts {
      padding: 4rem 0;
      background: var(--color-background-alt);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .related-posts h2 {
      font-size: 2rem;
      text-align: center;
      margin-bottom: 3rem;
      color: var(--color-primary);
    }

    .posts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
    }

    .post-card {
      background: var(--color-background);
      padding: 2rem;
      transition: transform 0.3s ease;
      border-top: 4px solid var(--color-secondary);
    }

    .post-card:hover {
      transform: translateY(-5px);
    }

    .post-meta {
      font-size: 0.875rem;
      color: var(--color-text-light);
      margin-bottom: 1rem;
    }

    .post-card h3 {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .post-card h3 a {
      color: var(--color-primary);
      transition: color 0.3s ease;
    }

    .post-card h3 a:hover {
      color: var(--color-secondary);
    }

    .post-description {
      color: var(--color-text-light);
      margin-bottom: 1rem;
      line-height: 1.6;
      font-size: 1rem;
    }

    .read-more {
      color: var(--color-secondary);
      font-weight: 600;
      transition: opacity 0.3s ease;
    }

    .read-more:hover {
      opacity: 0.8;
    }

    /* Footer */
    .footer {
      padding: 3rem 0 1.5rem;
      background: var(--color-background-alt);
      margin-top: 4rem;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .footer-logo img {
      height: 50px;
      margin-bottom: 0.75rem;
    }

    .footer-logo p {
      color: var(--color-text-light);
    }

    .footer-social {
      display: flex;
      gap: 1.5rem;
    }

    .footer-social a {
      color: var(--color-accent);
      transition: color 0.3s ease;
    }

    .footer-social a:hover {
      color: var(--color-secondary);
    }

    .footer-bottom {
      text-align: center;
      padding-top: 2rem;
      border-top: 1px solid #E5E7EB;
    }

    .footer-bottom p {
      color: var(--color-text-light);
      font-size: 0.875rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .nav-links {
        gap: 1rem;
        font-size: 0.875rem;
      }

      .article-header h1 {
        font-size: 2rem;
      }

      .article-description {
        font-size: 1.125rem;
      }

      .article-content {
        font-size: 1rem;
      }

      .article-content :global(h2) {
        font-size: 1.5rem;
      }

      .posts-grid {
        grid-template-columns: 1fr;
      }

      .footer-content {
        flex-direction: column;
        gap: 2rem;
        text-align: center;
      }
    }
  </style>
</Layout>
