---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date) {
  return new Date(date).toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<Layout title={`${post.data.title} - Mikas Food`}>
  <main>
    <!-- Navegación -->
    <nav class="nav">
      <div class="container">
        <a href="/" class="logo">Mikas</a>
        <div class="nav-menu">
          <a href="/">Inicio</a>
          <a href="/blog">Blog</a>
          <a href="/#contacto">Contacto</a>
        </div>
      </div>
    </nav>

    <!-- Artículo -->
    <article class="article">
      <div class="article-container">
        <header class="article-header">
          <a href="/blog" class="back-link">← Volver al blog</a>

          <time class="article-date">{formatDate(post.data.pubDate)}</time>

          <h1 class="article-title">{post.data.title}</h1>

          <p class="article-description">{post.data.description}</p>
        </header>

        <div class="article-content">
          <Content />
        </div>

        <footer class="article-footer">
          <div class="cta-box">
            <p>¿Te gustó este artículo? Descubre cómo Mikas puede mejorar la alimentación de tu mascota.</p>
            <a href="/#contacto" class="btn">Contáctanos</a>
          </div>
        </footer>
      </div>
    </article>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <span>© 2024 Mikas Food</span>
          <div class="footer-links">
            <a href="#">Instagram</a>
            <a href="#">Facebook</a>
          </div>
        </div>
      </div>
    </footer>
  </main>

  <style>
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--spacing-md);
    }

    /* Navegación */
    .nav {
      padding: var(--spacing-lg) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .nav .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .nav-menu {
      display: flex;
      gap: var(--spacing-lg);
    }

    .nav-menu a {
      font-size: 16px;
      font-weight: 500;
      color: var(--color-text-light);
      transition: color 0.2s ease;
    }

    .nav-menu a:hover {
      color: var(--color-text);
    }

    /* Artículo */
    .article {
      padding: var(--spacing-2xl) 0 var(--spacing-3xl);
    }

    .article-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 0 var(--spacing-md);
    }

    .article-header {
      padding-bottom: var(--spacing-2xl);
      margin-bottom: var(--spacing-2xl);
      border-bottom: 1px solid var(--color-border);
    }

    .back-link {
      display: inline-block;
      font-size: 16px;
      font-weight: 600;
      color: var(--color-text-light);
      margin-bottom: var(--spacing-lg);
      transition: color 0.2s ease;
    }

    .back-link:hover {
      color: var(--color-text);
    }

    .article-date {
      display: block;
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-light);
      margin-bottom: var(--spacing-md);
    }

    .article-title {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: var(--spacing-md);
    }

    .article-description {
      font-size: 1.25rem;
      color: var(--color-text-light);
      line-height: 1.6;
    }

    /* Contenido */
    .article-content {
      font-size: 1.125rem;
      line-height: 1.8;
    }

    .article-content :global(h2) {
      font-size: 2rem;
      font-weight: 700;
      margin-top: var(--spacing-2xl);
      margin-bottom: var(--spacing-md);
      line-height: 1.2;
    }

    .article-content :global(h3) {
      font-size: 1.5rem;
      font-weight: 700;
      margin-top: var(--spacing-xl);
      margin-bottom: var(--spacing-sm);
      line-height: 1.3;
    }

    .article-content :global(h4) {
      font-size: 1.25rem;
      font-weight: 600;
      margin-top: var(--spacing-lg);
      margin-bottom: var(--spacing-sm);
    }

    .article-content :global(p) {
      margin-bottom: var(--spacing-md);
    }

    .article-content :global(ul),
    .article-content :global(ol) {
      margin-bottom: var(--spacing-md);
      padding-left: var(--spacing-md);
    }

    .article-content :global(li) {
      margin-bottom: var(--spacing-xs);
    }

    .article-content :global(strong) {
      font-weight: 700;
    }

    .article-content :global(a) {
      color: var(--color-accent);
      font-weight: 600;
      transition: opacity 0.2s ease;
    }

    .article-content :global(a:hover) {
      opacity: 0.7;
    }

    .article-content :global(blockquote) {
      border-left: 3px solid var(--color-primary);
      padding-left: var(--spacing-md);
      margin: var(--spacing-lg) 0;
      font-style: italic;
      color: var(--color-text-light);
    }

    .article-content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: var(--spacing-lg) 0;
    }

    .article-content :global(th),
    .article-content :global(td) {
      padding: var(--spacing-sm);
      text-align: left;
      border-bottom: 1px solid var(--color-border);
    }

    .article-content :global(th) {
      font-weight: 700;
    }

    /* Article Footer */
    .article-footer {
      margin-top: var(--spacing-3xl);
      padding-top: var(--spacing-2xl);
      border-top: 1px solid var(--color-border);
    }

    .cta-box {
      text-align: center;
      padding: var(--spacing-2xl) var(--spacing-lg);
    }

    .cta-box p {
      font-size: 1.25rem;
      color: var(--color-text-light);
      margin-bottom: var(--spacing-lg);
      line-height: 1.6;
    }

    .btn {
      display: inline-block;
      padding: 1rem 2.5rem;
      background: var(--color-primary);
      color: var(--color-secondary);
      font-size: 16px;
      font-weight: 600;
      transition: opacity 0.2s ease;
    }

    .btn:hover {
      opacity: 0.8;
    }

    /* Footer */
    .footer {
      padding: var(--spacing-xl) 0;
      border-top: 1px solid var(--color-border);
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      color: var(--color-text-light);
    }

    .footer-links {
      display: flex;
      gap: var(--spacing-md);
    }

    .footer-links a {
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: var(--color-text);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .nav {
        padding: var(--spacing-md) 0;
      }

      .nav-menu {
        gap: var(--spacing-md);
      }

      .article {
        padding: var(--spacing-xl) 0;
      }

      .article-content {
        font-size: 1rem;
      }

      .article-content :global(h2) {
        font-size: 1.5rem;
      }

      .article-content :global(h3) {
        font-size: 1.25rem;
      }

      .footer-content {
        flex-direction: column;
        gap: var(--spacing-md);
        text-align: center;
      }
    }
  </style>
</Layout>
