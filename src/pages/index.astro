---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mikas Food">
  <main>
    <!-- Navegación -->
    <nav class="nav">
      <div class="container">
        <a href="/" class="logo">Mikas</a>
        <div class="nav-menu">
          <a href="/blog">Blog</a>
          <a href="#contacto">Contacto</a>
        </div>
      </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <h1 class="hero-title">
          Nutrición natural<br />
          para tus mascotas
        </h1>
        <p class="hero-subtitle">
          Sazonador de hígado de res 100% natural que transforma<br />
          las croquetas en una experiencia irresistible
        </p>
        <a href="#contacto" class="btn">Comenzar</a>
      </div>
    </section>

    <!-- Beneficios -->
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Por qué Mikas</h2>
        </div>

        <div class="grid">
          <div class="feature">
            <h3>100% Natural</h3>
            <p>Sin conservadores ni químicos. Solo hígado de res deshidratado de la más alta calidad.</p>
          </div>

          <div class="feature">
            <h3>Proteína Premium</h3>
            <p>Aminoácidos esenciales que fortalecen músculos y articulaciones.</p>
          </div>

          <div class="feature">
            <h3>Sistema Inmune</h3>
            <p>Vitaminas del complejo B que protegen y fortalecen la salud integral.</p>
          </div>

          <div class="feature">
            <h3>Digestión Saludable</h3>
            <p>Mejora la absorción de nutrientes y el funcionamiento intestinal.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Uso -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Modo de uso</h2>
        </div>

        <div class="steps">
          <div class="step">
            <span class="step-number">01</span>
            <h3>Sirve las croquetas</h3>
            <p>Coloca la porción habitual de tu mascota</p>
          </div>

          <div class="step">
            <span class="step-number">02</span>
            <h3>Espolvorea Mikas</h3>
            <p>Agrega una cucharadita sobre las croquetas</p>
          </div>

          <div class="step">
            <span class="step-number">03</span>
            <h3>Observa la diferencia</h3>
            <p>Tu mascota disfrutará cada bocado</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="section">
      <div class="container">
        <div class="contact-grid">
          <div>
            <h2 class="section-title">Conversemos</h2>
            <p class="contact-text">
              ¿Listo para transformar la alimentación de tu mascota?<br />
              Contáctanos y descubre cómo Mikas puede ayudar.
            </p>
          </div>

          <div class="contact-info">
            <div class="contact-item">
              <span class="label">Email</span>
              <a href="mailto:info@mikas.food">info@mikas.food</a>
            </div>

            <div class="contact-item">
              <span class="label">WhatsApp</span>
              <a href="https://wa.me/5215512345678">+52 55 1234 5678</a>
            </div>

            <div class="contact-item">
              <span class="label">Ubicación</span>
              <span>Ciudad de México, México</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <span>© 2024 Mikas Food</span>
          <div class="footer-links">
            <a href="#">Instagram</a>
            <a href="#">Facebook</a>
          </div>
        </div>
      </div>
    </footer>
  </main>

  <style>
    /* Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--spacing-md);
    }

    /* Navegación */
    .nav {
      padding: var(--spacing-lg) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .nav .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .nav-menu {
      display: flex;
      gap: var(--spacing-lg);
    }

    .nav-menu a {
      font-size: 16px;
      font-weight: 500;
      color: var(--color-text-light);
      transition: color 0.2s ease;
    }

    .nav-menu a:hover {
      color: var(--color-text);
    }

    /* Hero */
    .hero {
      padding: var(--spacing-3xl) 0;
      text-align: center;
    }

    .hero-title {
      font-size: clamp(3rem, 8vw, 6rem);
      font-weight: 800;
      margin-bottom: var(--spacing-md);
      line-height: 1;
    }

    .hero-subtitle {
      font-size: clamp(1.125rem, 2vw, 1.5rem);
      color: var(--color-text-light);
      margin-bottom: var(--spacing-xl);
      line-height: 1.5;
    }

    /* Button */
    .btn {
      display: inline-block;
      padding: 1rem 2.5rem;
      background: var(--color-primary);
      color: var(--color-secondary);
      font-size: 16px;
      font-weight: 600;
      transition: opacity 0.2s ease;
    }

    .btn:hover {
      opacity: 0.8;
    }

    /* Section */
    .section {
      padding: var(--spacing-3xl) 0;
      border-top: 1px solid var(--color-border);
    }

    .section-dark {
      background-color: var(--color-primary);
      color: var(--color-secondary);
    }

    .section-header {
      margin-bottom: var(--spacing-xl);
    }

    .section-title {
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 800;
    }

    /* Grid */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--spacing-xl);
    }

    .feature h3 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: var(--spacing-sm);
    }

    .feature p {
      color: var(--color-text-light);
      line-height: 1.7;
    }

    /* Steps */
    .steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--spacing-2xl);
      margin-top: var(--spacing-2xl);
    }

    .step {
      text-align: left;
    }

    .step-number {
      display: block;
      font-size: 3rem;
      font-weight: 800;
      color: rgba(255, 255, 255, 0.2);
      margin-bottom: var(--spacing-sm);
    }

    .step h3 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: var(--spacing-sm);
    }

    .step p {
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.7;
    }

    /* Contact */
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-2xl);
      align-items: start;
    }

    .contact-text {
      font-size: 1.25rem;
      color: var(--color-text-light);
      line-height: 1.7;
      margin-top: var(--spacing-md);
    }

    .contact-info {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-lg);
    }

    .contact-item {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .label {
      font-size: 0.875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-light);
    }

    .contact-item a {
      font-size: 1.25rem;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .contact-item a:hover {
      color: var(--color-accent);
    }

    .contact-item span:not(.label) {
      font-size: 1.25rem;
      font-weight: 600;
    }

    /* Footer */
    .footer {
      padding: var(--spacing-xl) 0;
      border-top: 1px solid var(--color-border);
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      color: var(--color-text-light);
    }

    .footer-links {
      display: flex;
      gap: var(--spacing-md);
    }

    .footer-links a {
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: var(--color-text);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .nav {
        padding: var(--spacing-md) 0;
      }

      .nav-menu {
        gap: var(--spacing-md);
      }

      .hero {
        padding: var(--spacing-2xl) 0;
      }

      .section {
        padding: var(--spacing-2xl) 0;
      }

      .grid {
        grid-template-columns: 1fr;
        gap: var(--spacing-lg);
      }

      .steps {
        grid-template-columns: 1fr;
        gap: var(--spacing-xl);
      }

      .contact-grid {
        grid-template-columns: 1fr;
      }

      .footer-content {
        flex-direction: column;
        gap: var(--spacing-md);
        text-align: center;
      }
    }
  </style>
</Layout>
