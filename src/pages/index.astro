---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mikas Food - Sazonador Natural para tus Mascotas">
  <main>
    <!-- Navegación -->
    <nav class="nav">
      <div class="nav-container">
        <div class="logo">
          <img src="/images/mika-logo.png" alt="Mikas Food" />
        </div>
        <div class="nav-links">
          <a href="/">Inicio</a>
          <a href="/blog">Blog</a>
          <a href="#contacto" class="btn-contact">Contáctanos</a>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-container">
        <div class="hero-content">
          <h1 class="hero-title">
            Transforma cada comida en una<br />
            <span class="highlight">experiencia deliciosa</span>
          </h1>
          <p class="hero-description">
            Sazonador natural de hígado de res que convierte las croquetas comunes
            en un festín irresistible para perros y gatos
          </p>
          <a href="#contacto" class="btn-primary">Quiero probarlo</a>
        </div>
        <div class="hero-image">
          <img src="/images/mika-logo2.png" alt="Mikas Food Producto" />
        </div>
      </div>
    </section>

    <!-- Beneficios Section -->
    <section class="benefits">
      <div class="container">
        <h2 class="section-title">¿Por qué elegir Mikas?</h2>
        <p class="section-subtitle">
          Nutrición premium que tu mascota merece
        </p>

        <div class="benefits-grid">
          <div class="benefit-card">
            <div class="benefit-icon">🍖</div>
            <h3>100% Natural</h3>
            <p>
              Elaborado con hígado de res deshidratado sin conservadores,
              químicos ni aditivos artificiales
            </p>
          </div>

          <div class="benefit-card">
            <div class="benefit-icon">💪</div>
            <h3>Proteína de Alto Valor</h3>
            <p>
              Rico en aminoácidos esenciales que fortalecen músculos,
              articulaciones y reducen la fatiga
            </p>
          </div>

          <div class="benefit-card">
            <div class="benefit-icon">❤️</div>
            <h3>Refuerza el Sistema Inmune</h3>
            <p>
              Vitaminas del complejo B que protegen órganos reproductivos,
              digestivos y sistema nervioso
            </p>
          </div>

          <div class="benefit-card">
            <div class="benefit-icon">✨</div>
            <h3>Digestión Saludable</h3>
            <p>
              Mejora el funcionamiento intestinal y facilita la absorción
              de nutrientes esenciales
            </p>
          </div>

          <div class="benefit-card">
            <div class="benefit-icon">🦴</div>
            <h3>Huesos y Articulaciones</h3>
            <p>
              Minerales que mantienen articulaciones saludables y promueven
              el crecimiento muscular
            </p>
          </div>

          <div class="benefit-card">
            <div class="benefit-icon">🌟</div>
            <h3>Anti-envejecimiento</h3>
            <p>
              Aminoácidos esenciales con propiedades antioxidantes que
              protegen las células
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Modo de Uso Section -->
    <section class="usage">
      <div class="container">
        <h2 class="section-title">Modo de uso</h2>
        <p class="section-subtitle">
          Tan simple como parece
        </p>

        <div class="usage-steps">
          <div class="step">
            <div class="step-number">1</div>
            <h3>Sirve las croquetas</h3>
            <p>Coloca la porción habitual de croquetas de tu mascota</p>
          </div>

          <div class="step">
            <div class="step-number">2</div>
            <h3>Espolvorea Mikas</h3>
            <p>Agrega una cucharadita del sazonador sobre las croquetas</p>
          </div>

          <div class="step">
            <div class="step-number">3</div>
            <h3>Mezcla y sirve</h3>
            <p>Revuelve suavemente y observa cómo tu mascota disfruta</p>
          </div>
        </div>

        <div class="usage-note">
          <p>
            <strong>Tip profesional:</strong> Puedes ajustar la cantidad según el tamaño
            de tu mascota. Apto para perros y gatos de todas las edades.
          </p>
        </div>
      </div>
    </section>

    <!-- Testimonios Section -->
    <section class="testimonials">
      <div class="container">
        <h2 class="section-title">Mascotas felices, dueños satisfechos</h2>
        <p class="section-subtitle">
          Historias reales de transformación
        </p>

        <div class="testimonials-grid">
          <div class="testimonial-card">
            <div class="testimonial-image">
              <img src="/images/mika-logo2.png" alt="Mascota feliz" />
            </div>
            <p class="testimonial-text">
              "Mi perro es súper selectivo con la comida. Desde que uso Mikas,
              termina su plato en segundos. ¡Es increíble!"
            </p>
            <p class="testimonial-author">— María, dueña de Max</p>
          </div>

          <div class="testimonial-card">
            <div class="testimonial-image">
              <img src="/images/mika-logo2.png" alt="Mascota feliz" />
            </div>
            <p class="testimonial-text">
              "Mis gatos nunca habían mostrado tanto entusiasmo por su comida.
              Además, noto que tienen más energía."
            </p>
            <p class="testimonial-author">— Carlos, dueño de Luna y Sol</p>
          </div>

          <div class="testimonial-card">
            <div class="testimonial-image">
              <img src="/images/mika-logo2.png" alt="Mascota feliz" />
            </div>
            <p class="testimonial-text">
              "Me encanta que sea 100% natural. Le da a mi perro senior
              el boost nutricional que necesita sin químicos."
            </p>
            <p class="testimonial-author">— Ana, dueña de Rocky</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contacto Section -->
    <section id="contacto" class="contact">
      <div class="container">
        <div class="contact-content">
          <div class="contact-info">
            <h2>¿Listo para transformar la alimentación de tu mascota?</h2>
            <p>
              Contáctanos y descubre cómo Mikas puede hacer que cada comida
              sea especial para tu mejor amigo.
            </p>

            <div class="contact-methods">
              <div class="contact-method">
                <div class="method-icon">📧</div>
                <div>
                  <h4>Email</h4>
                  <a href="mailto:info@mikas.food">info@mikas.food</a>
                </div>
              </div>

              <div class="contact-method">
                <div class="method-icon">📱</div>
                <div>
                  <h4>WhatsApp</h4>
                  <a href="https://wa.me/5215512345678">+52 55 1234 5678</a>
                </div>
              </div>

              <div class="contact-method">
                <div class="method-icon">📍</div>
                <div>
                  <h4>Ubicación</h4>
                  <p>Ciudad de México, México</p>
                </div>
              </div>
            </div>
          </div>

          <div class="contact-image">
            <img src="/images/mika-logo2.png" alt="Contacto Mikas" />
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-logo">
            <img src="/images/mika-logo.png" alt="Mikas Food" />
            <p>Nutrición natural para mascotas felices</p>
          </div>

          <div class="footer-social">
            <a href="#" aria-label="Facebook">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="#" aria-label="Instagram">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <a href="#" aria-label="TikTok">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; 2024 Mikas Food. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>
  </main>

  <style>
    /* Variables y reset ya están en Layout.astro */

    /* Navegación */
    .nav {
      padding: 1.5rem 0;
      background: var(--color-background);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo img {
      height: 60px;
      width: auto;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      align-items: center;
    }

    .nav-links a {
      font-weight: 500;
      transition: color 0.3s ease;
      color: var(--color-text);
    }

    .nav-links a:not(.btn-contact):hover {
      color: var(--color-secondary);
    }

    .btn-contact {
      padding: 0.75rem 2rem;
      background: var(--color-primary);
      color: white !important;
      font-weight: 500;
      transition: background 0.3s ease;
    }

    .btn-contact:hover {
      background: var(--color-accent);
    }

    /* Hero Section */
    .hero {
      padding: 6rem 0;
      background: var(--color-background-alt);
    }

    .hero-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }

    .hero-title {
      font-size: 3.5rem;
      margin-bottom: 1.5rem;
      color: var(--color-primary);
    }

    .highlight {
      color: var(--color-secondary);
    }

    .hero-description {
      font-size: 1.25rem;
      color: var(--color-text-light);
      margin-bottom: 2rem;
      line-height: 1.8;
    }

    .btn-primary {
      display: inline-block;
      padding: 1rem 2.5rem;
      background: var(--color-secondary);
      color: white;
      font-weight: 600;
      font-size: 1.125rem;
      transition: transform 0.3s ease, background 0.3s ease;
    }

    .btn-primary:hover {
      background: #d66e43;
      transform: translateY(-2px);
    }

    .hero-image img {
      width: 100%;
      height: auto;
      max-width: 500px;
    }

    /* Container genérico */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* Section Titles */
    .section-title {
      font-size: 2.5rem;
      text-align: center;
      margin-bottom: 1rem;
      color: var(--color-primary);
    }

    .section-subtitle {
      text-align: center;
      font-size: 1.25rem;
      color: var(--color-text-light);
      margin-bottom: 4rem;
    }

    /* Benefits Section */
    .benefits {
      padding: 6rem 0;
      background: var(--color-background);
    }

    .benefits-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 3rem;
    }

    .benefit-card {
      text-align: center;
      padding: 2rem;
      transition: transform 0.3s ease;
    }

    .benefit-card:hover {
      transform: translateY(-5px);
    }

    .benefit-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    .benefit-card h3 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      color: var(--color-primary);
    }

    .benefit-card p {
      color: var(--color-text-light);
      line-height: 1.7;
    }

    /* Usage Section */
    .usage {
      padding: 6rem 0;
      background: var(--color-background-alt);
    }

    .usage-steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
      margin-bottom: 3rem;
    }

    .step {
      text-align: center;
    }

    .step-number {
      width: 60px;
      height: 60px;
      background: var(--color-secondary);
      color: white;
      font-size: 1.5rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
    }

    .step h3 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      color: var(--color-primary);
    }

    .step p {
      color: var(--color-text-light);
      line-height: 1.7;
    }

    .usage-note {
      background: white;
      padding: 2rem;
      text-align: center;
      max-width: 800px;
      margin: 0 auto;
    }

    .usage-note p {
      color: var(--color-text-light);
      font-size: 1.125rem;
    }

    .usage-note strong {
      color: var(--color-secondary);
    }

    /* Testimonials Section */
    .testimonials {
      padding: 6rem 0;
      background: var(--color-background);
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 3rem;
    }

    .testimonial-card {
      background: var(--color-background-alt);
      padding: 2rem;
      text-align: center;
    }

    .testimonial-image {
      width: 100px;
      height: 100px;
      margin: 0 auto 1.5rem;
      overflow: hidden;
    }

    .testimonial-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .testimonial-text {
      font-style: italic;
      color: var(--color-text-light);
      margin-bottom: 1rem;
      line-height: 1.7;
    }

    .testimonial-author {
      font-weight: 600;
      color: var(--color-primary);
    }

    /* Contact Section */
    .contact {
      padding: 6rem 0;
      background: var(--color-primary);
      color: white;
    }

    .contact-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }

    .contact-info h2 {
      font-size: 2.5rem;
      margin-bottom: 1.5rem;
      color: white;
    }

    .contact-info > p {
      font-size: 1.25rem;
      margin-bottom: 3rem;
      opacity: 0.9;
    }

    .contact-methods {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .contact-method {
      display: flex;
      gap: 1.5rem;
      align-items: flex-start;
    }

    .method-icon {
      font-size: 2rem;
    }

    .contact-method h4 {
      margin-bottom: 0.5rem;
      font-size: 1.125rem;
    }

    .contact-method a {
      color: var(--color-secondary);
      transition: opacity 0.3s ease;
    }

    .contact-method a:hover {
      opacity: 0.8;
    }

    .contact-method p {
      opacity: 0.9;
    }

    .contact-image img {
      width: 100%;
      height: auto;
      max-width: 400px;
    }

    /* Footer */
    .footer {
      padding: 3rem 0 1.5rem;
      background: var(--color-background-alt);
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .footer-logo img {
      height: 50px;
      margin-bottom: 0.75rem;
    }

    .footer-logo p {
      color: var(--color-text-light);
    }

    .footer-social {
      display: flex;
      gap: 1.5rem;
    }

    .footer-social a {
      color: var(--color-accent);
      transition: color 0.3s ease;
    }

    .footer-social a:hover {
      color: var(--color-secondary);
    }

    .footer-bottom {
      text-align: center;
      padding-top: 2rem;
      border-top: 1px solid #E5E7EB;
    }

    .footer-bottom p {
      color: var(--color-text-light);
      font-size: 0.875rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .nav-links {
        gap: 1rem;
        font-size: 0.875rem;
      }

      .hero-container {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .hero-title {
        font-size: 2.5rem;
      }

      .hero-image {
        order: -1;
      }

      .hero-image img {
        max-width: 300px;
        margin: 0 auto;
      }

      .usage-steps {
        grid-template-columns: 1fr;
      }

      .contact-content {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .contact-image {
        display: none;
      }

      .contact-method {
        justify-content: center;
      }

      .footer-content {
        flex-direction: column;
        gap: 2rem;
        text-align: center;
      }

      .section-title {
        font-size: 2rem;
      }

      .benefits-grid,
      .testimonials-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
